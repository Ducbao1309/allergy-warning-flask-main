# Flask session signing key (generate a long random value)
SECRET_KEY=replace-with-a-long-random-secret

# Database option A: TiDB Cloud / MySQL with SSL
DB_HOST=your-database-host
DB_PORT=4000
DB_USER=your-database-user
DB_PASSWORD=your-database-password
DB_NAME=allergy_warning
DB_SSL_CA=certs/isrgrootx1.pem

# Database option B: XAMPP local MySQL (uncomment and use instead of option A)
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_USER=root
# DB_PASSWORD=
# DB_NAME=allergy_warning
# DB_SSL_CA=

# Or provide one complete URI instead of DB_HOST/DB_PORT/DB_USER/DB_PASSWORD/DB_NAME
# DATABASE_URL=mysql+pymysql://user:password@host:3306/database

GEMINI_API_KEY=replace-with-your-gemini-api-key

# Required for persisting scan images outside the local filesystem
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-cloudinary-api-key
CLOUDINARY_API_SECRET=your-cloudinary-api-secret

# Optional on Windows if Tesseract OCR is installed
# TESSERACT_CMD=C:/Program Files/Tesseract-OCR/tesseract.exe
