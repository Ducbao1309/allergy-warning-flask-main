% ---------- Tiêu đề chương / mục ------------------------------------
\RequirePackage{titlesec}
\titleformat{\chapter}[display]
     {\sffamily\bfseries}
     {\flushright\fontsize{52}{52}\selectfont\color{daugold}\thechapter}
     {0pt}
     {\color{daumaroon}\Huge\filright}
     [\vspace{2pt}{\color{daugold}\titlerule[2.5pt]}]
\titlespacing*{\chapter}{0pt}{0pt}{16pt}
\titleformat{\section}
     {\sffamily\Large\bfseries\color{daumaroon}}{\thesection}{0.6em}{}
\titleformat{\subsection}[block]
     {\sffamily\large\bfseries\color{daunavy}}
     {\thesubsection}
     {0.6em}
     {}
\titleformat{\subsubsection}
     {\sffamily\normalsize\bfseries\color{gray700}}{\thesubsubsection}{0.6em}{}
\setcounter{secnumdepth}{3}
\setcounter{tocdepth}{2}
% ---------- Header / footer -----------------------------------------
\RequirePackage{fancyhdr}
\newcommand{\dauPageStyle}{%
     \pagestyle{fancy}%
     \fancyhf{}%
     \renewcommand{\headrulewidth}{0.6pt}%
     \renewcommand{\headrule}{\hbox to\headwidth{\color{daugold}\leaders\hrule height \headrulewidth\hfill}}%
     \fancyhead[L]{\footnotesize\color{gray500}\nouppercase{\leftmark}}%
     \fancyhead[R]{\footnotesize\color{gray500}\@rname}%
     \fancyfoot[L]{\footnotesize\color{gray500}\@stuname{} \textperiodcentered{} \@smssv}%
     % Phần đầu: số La Mã nằm giữa.
     % Phần nội dung chính: số Ả Rập nằm bên phải.
     \fancyfoot[C]{\if@mainmatter\else\footnotesize\color{gray500}\thepage\fi}%
     \fancyfoot[R]{\if@mainmatter\footnotesize\color{gray500}\thepage\fi}%
     \renewcommand{\chaptermark}[1]{\markboth{Chương \thechapter.\ ##1}{}}%
}
% Kiểu trang plain dùng cho trang đầu chương.
% Vị trí số trang vẫn theo quy tắc của phần đầu và phần nội dung.
\fancypagestyle{plain}{%
     \fancyhf{}%
     \renewcommand{\headrulewidth}{0pt}%
     \fancyfoot[C]{\if@mainmatter\else\footnotesize\color{gray500}\thepage\fi}%
     \fancyfoot[R]{\if@mainmatter\footnotesize\color{gray500}\thepage\fi}%
}
