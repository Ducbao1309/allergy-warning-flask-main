% =====================================================================
%  styles/dau.sty
%  Nhận diện và định dạng đồ án tốt nghiệp, Khoa Công nghệ Thông tin,
%  Trường Đại học Kiến trúc Đà Nẵng.
%
%  Nguồn gốc: chuyển thể từ mẫu đồ án của Trường Đại học Nha Trang
%  (github.com/nd-hung/thesis-template, tác giả TS. Nguyễn Đình Hưng),
%  giữ nguyên bộ lệnh khai báo thông tin và các môi trường lời cam đoan,
%  lời cảm ơn, tóm tắt. Toàn bộ phần nhận diện, phông chữ, bảng màu,
%  trang bìa và các hộp trình bày được thay bằng chuẩn của DAU.
% =====================================================================
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{dau}[2026/08/18 Do an TTNT AIP202, Khoa CNTT DAU]
% ---------- Fonts & ngôn ngữ ----------------------------------------
\RequirePackage{fontspec}
\RequirePackage{polyglossia}
\setdefaultlanguage{vietnamese}
\setotherlanguage{english}
% Dùng các font phổ biến có sẵn trên Windows.
% Không dùng Noto Sans / Latin Modern qua cơ chế tạo font của MiKTeX.
\setmainfont{Times New Roman}
\setsansfont{Arial}
\setmonofont{Consolas}
