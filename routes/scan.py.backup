import os
import uuid
import logging
from itsdangerous import BadSignature, SignatureExpired, URLSafeTimedSerializer

from flask import (
    Blueprint,
    render_template,
    request,
    redirect,
    url_for,
    session,
    current_app,
    flash
)
from werkzeug.exceptions import RequestEntityTooLarge
from sqlalchemy.exc import SQLAlchemyError

from services.gemini_service import (
    GeminiConfigurationError,
    GeminiServiceError,
    InvalidProductImageError,
    analyze_product_image,
)

from services.product_service import (
    find_product_by_identity,
    save_scanned_product,
    get_product_ingredients,
    get_product_allergens,
    check_product_ingredients,
    has_unsupported_allergen_tags,
)

from models import UserAllergen

logger = logging.getLogger(__name__)
SCAN_SAVE_SALT = "scan-save-product-v1"


scan_bp = Blueprint(
    "scan",
    __name__,
    url_prefix="/scan"
)


@scan_bp.errorhandler(RequestEntityTooLarge)
def upload_too_large(_error):
    flash("Ảnh vượt quá giới hạn tải lên 10 MB. Vui lòng chọn ảnh nhỏ hơn.", "error")
    return render_template("scan.html"), 413
# ========================================
# TRANG QUÉT
# ========================================

@scan_bp.route("/")
def scan_page():

    if "user_id" not in session:

        return redirect(
            url_for("auth.login")
        )


    return render_template(
        "scan.html"
    )


# ========================================
# XỬ LÝ ẢNH
# ========================================

@scan_bp.route(
    "/process",
    methods=["POST"]
)
def process_scan():
    logger.info("[SCAN] POST /scan/process RECEIVED")
    logger.info("[SCAN] files=%s", list(request.files.keys()))

    # ====================================
    # 1. KIỂM TRA ĐĂNG NHẬP
    # ====================================

    if "user_id" not in session:

        return redirect(
            url_for("auth.login")
        )


    # ====================================
    # 2. LẤY ẢNH
    # ====================================

    uploaded_file = request.files.get(
        "image"
    )
    logger.info(
        "[SCAN] uploaded_file=%s filename=%s content_type=%s",
        bool(uploaded_file),
        getattr(uploaded_file, "filename", None),
        getattr(uploaded_file, "content_type", None),
    )


    if uploaded_file is None:

        flash(
            "Vui lòng chọn ảnh.",
            "error"
        )

        return redirect(
            url_for("scan.scan_page")
        )


    if uploaded_file.filename == "":

        flash(
            "Vui lòng chọn ảnh.",
            "error"
        )

        return redirect(
            url_for("scan.scan_page")
        )


    # ====================================
    # 3. KIỂM TRA ĐỊNH DẠNG
    # ====================================

    extension = os.path.splitext(
        uploaded_file.filename
    )[1].lower()


    allowed_extensions = (
        current_app.config[
            "ALLOWED_EXTENSIONS"
        ]
    )


    if (
        extension.replace(".", "")
        not in allowed_extensions
    ):

        flash(
            "Định dạng ảnh không được hỗ trợ.",
            "error"
        )

        return redirect(
            url_for("scan.scan_page")
        )

    expected_mime_types = {
        ".jpg": {"image/jpeg", "image/jpg"},
        ".jpeg": {"image/jpeg", "image/jpg"},
        ".png": {"image/png"},
        ".webp": {"image/webp"},
    }
    uploaded_mime_type = (uploaded_file.mimetype or "").lower()
    generic_mime_types = {"", "application/octet-stream", "binary/octet-stream"}
    if (
        uploaded_mime_type not in generic_mime_types
        and uploaded_mime_type not in expected_mime_types.get(extension, set())
    ):
        flash(
            "Định dạng nội dung ảnh không khớp với phần mở rộng tệp.",
            "error",
        )
        return redirect(url_for("scan.scan_page"))

    # ====================================
    # 4. TẠO THƯ MỤC UPLOAD
    # ====================================

    upload_folder = os.path.join(
        current_app.root_path,
        "static",
        "uploads"
    )


    os.makedirs(
        upload_folder,
        exist_ok=True
    )


    # ====================================
    # 5. LƯU ẢNH
    # ====================================

    filename = (
        str(uuid.uuid4())
        + extension
    )


    filepath = os.path.join(
        upload_folder,
        filename
    )


    uploaded_file.save(filepath)

    # ====================================
    # 6. GEMINI IMAGE ANALYSIS
    # ====================================

    try:
        label_data = analyze_product_image(filepath)
    except GeminiConfigurationError:
        current_app.logger.error("GEMINI_API_KEY is not configured.")
        flash(
            "Chức năng phân tích nhãn chưa được cấu hình. Vui lòng liên hệ quản trị viên.",
            "error",
        )
        return redirect(url_for("scan.scan_page"))
    except InvalidProductImageError:
        flash(
            "Tệp tải lên không phải ảnh hợp lệ hoặc định dạng ảnh chưa được hỗ trợ.",
            "error",
        )
        return redirect(url_for("scan.scan_page"))
    except GeminiServiceError as error:
        logger.error("Gemini label analysis failed (%s).", type(error).__name__)
        flash(
            "Gemini bị quá thời gian chờ hoặc gặp lỗi khi phân tích ảnh. Vui lòng thử lại.",
            "error",
        )
        return redirect(url_for("scan.scan_page"))

    product_name_from_gemini = label_data["product_name"]
    brand_from_gemini = label_data.get("brand", "")
    gemini_ingredients = label_data["ingredients"]
    gemini_allergens = label_data["allergens"]
    text_parts = []
    if product_name_from_gemini:
        text_parts.append(f"Tên sản phẩm: {product_name_from_gemini}")
    if gemini_ingredients:
        text_parts.append("Thành phần: " + ", ".join(gemini_ingredients))
    if gemini_allergens:
        text_parts.append("Dị nguyên nhận diện: " + ", ".join(gemini_allergens))
    text = "\n".join(text_parts) or "Không đọc được nội dung từ ảnh."


    # ====================================
    # 7. TÌM SẢN PHẨM TRONG DATABASE
    # ====================================

    try:
        product = find_product_by_identity(
            product_name_from_gemini,
            brand_from_gemini,
        ) if product_name_from_gemini and brand_from_gemini else None
    except SQLAlchemyError as error:
        logger.error(
            "Product identity lookup failed; continuing with Gemini data (%s).",
            type(error).__name__,
        )
        product = None


    # ====================================
    # 8. LẤY THÀNH PHẦN SẢN PHẨM
    # ====================================

    catalog_ingredients = (
        get_product_ingredients(
            product
        )
    )
    product_ingredients = list(
        dict.fromkeys(gemini_ingredients + catalog_ingredients)
    )


    # ====================================
    # 9. LẤY DỊ NGUYÊN SẢN PHẨM
    # ====================================

    product_allergens = (
        get_product_allergens(
            product
        )
    )
    # ====================================
    # 10. LẤY DỊ NGUYÊN USER
    # ====================================

    try:
        user_allergens = (
            UserAllergen.query
            .filter_by(
                user_id=session["user_id"]
            )
            .all()
        )
    except SQLAlchemyError as error:
        logger.error(
            "Allergy profile lookup failed; warning status will be unknown (%s).",
            type(error).__name__,
        )
        user_allergens = []


    user_allergen_tags = {
        item.allergen.off_tag
        for item in user_allergens
        if item.allergen.off_tag
    }


    # ====================================
    # 11. SO SÁNH
    #
    # THÀNH PHẦN SẢN PHẨM
    #          VS
    # DỊ NGUYÊN USER
    # ====================================

    allergens = (
        check_product_ingredients(
            product_ingredients + gemini_allergens,
            user_allergen_tags,
            product_allergens,
        )
    )

    match_unknown = (
        not user_allergen_tags
        or has_unsupported_allergen_tags(user_allergen_tags)
        or not (product_ingredients or product_allergens or gemini_allergens)
    )
    # ====================================
    # 12. HIỂN THỊ KẾT QUẢ
    # ====================================

    return render_template(

        "scan_result.html",

        text=text,

        product=product,

        product_name=(
            product.name if product else product_name_from_gemini
        ),

        product_brand=(product.brand if product else brand_from_gemini),

        save_token=(
            URLSafeTimedSerializer(current_app.secret_key, salt=SCAN_SAVE_SALT).dumps({
                "product_name": product_name_from_gemini,
                "brand": brand_from_gemini,
                "ingredients": gemini_ingredients,
                "allergens": gemini_allergens,
                "image_filename": filename,
            })
            if not product and product_name_from_gemini
            else None
        ),

        gemini_allergens=gemini_allergens,

        match_unknown=match_unknown,

        product_ingredients=(
            product_ingredients
        ),

        product_allergens=(
            product_allergens
        ),

        allergens=allergens,

        image_path=url_for(
            "static",
            filename=(
                f"uploads/{filename}"
            )
        )
    )


@scan_bp.route("/save-product", methods=["POST"])
def save_scan_product():
    if "user_id" not in session:
        return redirect(url_for("auth.login"))

    token = request.form.get("save_token", "")
    serializer = URLSafeTimedSerializer(current_app.secret_key, salt=SCAN_SAVE_SALT)
    try:
        payload = serializer.loads(token, max_age=3600)
    except (BadSignature, SignatureExpired):
        flash("Kết quả quét đã hết hạn hoặc không hợp lệ. Vui lòng quét lại.", "error")
        return redirect(url_for("scan.scan_page"))

    token_key = str(uuid.uuid5(uuid.NAMESPACE_URL, token))
    saved_tokens = session.get("saved_scan_tokens", [])
    if token_key in saved_tokens:
        flash("Sản phẩm đã được lưu trước đó.", "info")
        return redirect(url_for("scan.scan_page"))

    image_filename = payload.get("image_filename", "")
    if (
        not isinstance(image_filename, str)
        or os.path.basename(image_filename) != image_filename
        or os.path.splitext(image_filename)[1].lower() not in {".jpg", ".jpeg", ".png", ".webp"}
    ):
        flash("Không thể xác định ảnh của kết quả quét. Vui lòng quét lại.", "error")
        return redirect(url_for("scan.scan_page"))

    image_path = os.path.join(current_app.root_path, "static", "uploads", image_filename)
    if not os.path.isfile(image_path):
        flash("Ảnh kết quả quét không còn tồn tại. Vui lòng quét lại.", "error")
        return redirect(url_for("scan.scan_page"))

    try:
        product, created = save_scanned_product(
            payload,
            url_for("static", filename=f"uploads/{image_filename}"),
        )
    except Exception:
        logger.error("Saving scanned product failed.")
        flash("Không thể lưu sản phẩm lúc này. Vui lòng thử lại sau.", "error")
        return redirect(url_for("scan.scan_page"))

    saved_tokens.append(token_key)
    session["saved_scan_tokens"] = saved_tokens[-20:]
    if created:
        flash("Đã lưu sản phẩm vào cơ sở dữ liệu.", "success")
    else:
        flash("Sản phẩm đã tồn tại trong cơ sở dữ liệu.", "info")
    return redirect(url_for("scan.scan_page"))
